#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: resolve-export <input> [output.mp4] [crf=18]" >&2
  exit 1
fi

in="$1"
out="${2:-${in%.*}-h264.mp4}"
crf="${3:-18}"

ffmpeg -i "$in" \
  -c:v libx264 -preset slow -crf "$crf" -pix_fmt yuv420p \
  -c:a aac -b:a 192k \
  -movflags +faststart \
  "$out"