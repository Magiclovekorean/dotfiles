tmp

# Stretchly: everything under ~/.config/Stretchly is Electron runtime state
# (caches, cookies, etc.) except the preferences file.
home/config/Stretchly/*
!home/config/Stretchly/config.json

# .qmlls.ini holds machine-specific QML store paths for qmlls. The home.activation
# hook initQuickshellQmllsConfig writes it, and quickshell overwrites it with its
# own vfs-backed version if run manually.
home/config/quickshell/.qmlls.ini

