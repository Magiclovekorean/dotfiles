{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "verbosity": "medium",
    "image_preview": true,
    "tps": false,
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "sound": true,
    "notifications": true,
    "volume": 0.9999999999999999
  },
  "terminal": {
    "copy": "select"
  }
}