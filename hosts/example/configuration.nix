{
  config,
  lib,
  pkgs,
  ...
}: {
  imports = [
    (if builtins.pathExists ./hardware-configuration.nix then ./hardware-configuration.nix else { })
  ];

  boot.loader = {
    systemd-boot.enable = true;
    efi.canTouchEfiVariables = true;
  };

  networking.hostName = "changeme-host";

  # Dummy root filesystem for flake check (real one generated by nixos-generate-config at install)
  fileSystems."/" = {
    fsType = "ext4";
    device = "/dev/disk/by-label/root";
  };
}
